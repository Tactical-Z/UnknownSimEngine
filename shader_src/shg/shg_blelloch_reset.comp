#version 450 core

layout (local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 4)
buffer CounterBuffer
{
    uint cellCount;
};

layout(std430, binding = 7)
buffer cellPrefixBuffer {
    uint cellScan[];
};


void main() {

    int last = cellScan.length() - 1;
    cellCount = cellScan[last];
    cellScan[last] = 0;
}