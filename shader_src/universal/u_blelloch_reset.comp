#version 450 core

layout (local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 4) writeonly buffer CounterBuffer
{
    uint count;
};

layout(std430, binding = 7) buffer cellPrefixBuffer {
    uint cellPrefixes[];
};

void main() {

    int last = cellPrefixes.length() - 1;
    count = cellPrefixes[last];
    cellPrefixes[last] = 0;
}